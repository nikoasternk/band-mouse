<template>
  <div class="menu-page">
    <scroll class="menu-scroll" scroll-y="true">
      <div class="edge-spacer"></div>

      <div class="action-btn" @click="goBackToPad">
        <text class="action-btn-txt" style="font-size: {{backFont}}px;">{{strings.backToPad}}</text>
      </div>

      <div class="mode-card">
        <text class="card-title" style="font-size: {{modeTitleFont}}px;">{{strings.modeTitle}}</text>
        <div class="{{controlMode === 'scroll' ? 'mode-toggle toggle-dark' : 'mode-toggle toggle-light'}}" @click="cycleControlMode">
          <text class="{{controlMode === 'scroll' ? 'toggle-txt-light' : 'toggle-txt-dark'}}" style="font-size: {{modeBtnFont}}px;">{{modeLabel}}</text>
        </div>
      </div>

      <div class="mode-card">
        <text class="card-title" style="font-size: {{brightTitleFont}}px;">{{strings.phoneBrightTitle}}</text>
        <div class="mode-toggle {{phoneBrightnessOn ? 'toggle-light' : 'toggle-dark'}}" @click="togglePhoneBrightness">
          <text class="{{phoneBrightnessOn ? 'toggle-txt-dark' : 'toggle-txt-light'}}" style="font-size: {{brightToggleFont}}px;">{{phoneBrightnessOn ? strings.enabled : strings.disabled}}</text>
        </div>
      </div>

      <div class="mode-card" if="{{phoneBrightnessOn}}">
        <text class="card-title" style="font-size: {{brightLvlTitleFont}}px;">{{strings.phoneBrightLevel}}</text>
        <div class="ctrl-row">
          <div class="ctrl-btn" @click="changePhoneBrightness(-10)">
            <text class="ctrl-btn-txt">-</text>
          </div>
          <text class="ctrl-val">{{phoneBrightnessPct}}%</text>
          <div class="ctrl-btn" @click="changePhoneBrightness(10)">
            <text class="ctrl-btn-txt">+</text>
          </div>
        </div>
      </div>

      <div class="action-btn" @click="openSettings">
        <text class="action-btn-txt" style="font-size: {{settingsFont}}px;">{{strings.settings}}</text>
      </div>

      <div class="exit-btn" @click="exitApplication">
        <text class="exit-btn-txt" style="font-size: {{exitFont}}px;">{{strings.exitApp}}</text>
      </div>

      <div class="edge-spacer-bottom"></div>
    </scroll>
  </div>
</template>

<script>
import router from '@system.router'
import { getStrings, fitFontSize } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    controlMode: 'cursor',
    modeLabel: 'CURSOR',
    phoneBrightnessOn: false,
    phoneBrightnessPct: 50,
    backFont: 22,
    modeTitleFont: 19,
    modeBtnFont: 21,
    brightTitleFont: 19,
    brightToggleFont: 21,
    brightLvlTitleFont: 19,
    settingsFont: 22,
    exitFont: 22
  },

  onShow() {
    globalThis.notifyPageShown();
    globalThis.loadMouseConfig((cfg) => {
      this.strings = getStrings(cfg.language || 'auto');
      this.controlMode = cfg.controlMode || 'cursor';
      this.phoneBrightnessOn = cfg.phoneBrightnessOn === true;
      this.phoneBrightnessPct = cfg.phoneBrightnessPct !== undefined ? cfg.phoneBrightnessPct : 50;
      this.updateModeLabelAndFonts();
    });
  },

  onHide() {
    globalThis.notifyPageHidden();
  },

  updateModeLabelAndFonts() {
    const s = this.strings;
    if (this.controlMode === 'scroll') {
      this.modeLabel = s.modeScroll;
    } else if (this.controlMode === 'hybrid') {
      this.modeLabel = s.modeHybrid;
    } else {
      this.modeLabel = s.modeCursor;
    }

    this.backFont = fitFontSize(s.backToPad, 172, 23, 16, true);
    this.modeTitleFont = fitFontSize(s.modeTitle, 172, 19, 14, false);
    this.modeBtnFont = fitFontSize(this.modeLabel, 164, 22, 16, true);
    this.brightTitleFont = fitFontSize(s.phoneBrightTitle, 172, 19, 14, false);
    this.brightToggleFont = fitFontSize(this.phoneBrightnessOn ? s.enabled : s.disabled, 164, 22, 16, true);
    this.brightLvlTitleFont = fitFontSize(s.phoneBrightLevel, 172, 19, 14, false);
    this.settingsFont = fitFontSize(s.settings, 172, 23, 16, true);
    this.exitFont = fitFontSize(s.exitApp, 172, 23, 16, true);
  },

  cycleControlMode() {
    if (this.controlMode === 'cursor') {
      this.controlMode = 'scroll';
    } else if (this.controlMode === 'scroll') {
      this.controlMode = 'hybrid';
    } else {
      this.controlMode = 'cursor';
    }
    globalThis.mouseConfig.controlMode = this.controlMode;
    globalThis.saveMouseConfig();
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({
        tag: 'mouse',
        act: 's_mode',
        drag: globalThis.mouseConfig.dragScroll !== false,
        mode: this.controlMode
      });
    }
    this.updateModeLabelAndFonts();
    globalThis.triggerHaptic('soft');
  },

  togglePhoneBrightness() {
    this.phoneBrightnessOn = !this.phoneBrightnessOn;
    globalThis.mouseConfig.phoneBrightnessOn = this.phoneBrightnessOn;
    globalThis.saveMouseConfig();
    this.syncPhoneBrightness();
    this.updateModeLabelAndFonts();
    globalThis.triggerHaptic('soft');
  },

  changePhoneBrightness(delta) {
    const next = Math.round((this.phoneBrightnessPct + delta) / 10) * 10;
    this.phoneBrightnessPct = Math.max(0, Math.min(100, next));
    globalThis.mouseConfig.phoneBrightnessPct = this.phoneBrightnessPct;
    globalThis.saveMouseConfig();
    this.syncPhoneBrightness();
    globalThis.triggerHaptic('soft');
  },

  syncPhoneBrightness() {
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({
        tag: 'mouse',
        act: 'p_bright',
        on: this.phoneBrightnessOn,
        pct: this.phoneBrightnessPct
      });
    }
  },

  goBackToPad() {
    globalThis.triggerHaptic('soft');
    router.back();
  },

  openSettings() {
    globalThis.triggerHaptic('soft');
    router.push({ uri: 'pages/settings' });
  },

  exitApplication() {
    globalThis.triggerHaptic('soft');
    globalThis.forceCloseWatchApp(this.$app);
  }
}
</script>

