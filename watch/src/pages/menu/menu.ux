  width: 212px;
  height: 520px;
  background-color: #000000;
}

.menu-scroll {
  width: 212px;
  height: 520px;
  flex-direction: column;
  align-items: center;
}

.edge-spacer {
  width: 200px;
  height: 34px;
  flex-shrink: 0;
}

.edge-spacer-bottom {
  width: 200px;
  height: 48px;
  flex-shrink: 0;
}

.action-btn {
  width: 200px;
  height: 68px;
  flex-shrink: 0;
  background-color: #262626;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
}

.action-btn-txt {
  color: #FFFFFF;
  font-weight: bold;
  text-align: center;
  lines: 1;
}

.mode-card {
  width: 200px;
  height: 148px;
  flex-shrink: 0;
  background-color: #1A1A1A;
  border-radius: 26px;
  padding: 12px 10px;
  margin-bottom: 10px;
  flex-direction: column;
  justify-content: space-between;
  align-items: center;
}

.card-title {
  width: 176px;
  color: #FFFFFF;
  font-weight: bold;
  text-align: center;
  lines: 2;
}

.mode-toggle {
  width: 176px;
  height: 60px;
  flex-shrink: 0;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
}

.toggle-light {
  background-color: #FFFFFF;
}

.toggle-dark {
  background-color: #303030;
}

.toggle-txt-dark {
  color: #000000;
  font-weight: bold;
  lines: 1;
}

.toggle-txt-light {
  color: #FFFFFF;
  font-weight: bold;
  lines: 1;
}

.ctrl-row {
  width: 176px;
  height: 60px;
  flex-shrink: 0;
  justify-content: space-between;
  align-items: center;
}

.ctrl-btn {
  width: 56px;
  height: 60px;
  flex-shrink: 0;
  background-color: #303030;
  border-radius: 18px;
  justify-content: center;
  align-items: center;
}

.ctrl-btn-txt {
  color: #FFFFFF;
  font-size: 32px;
  font-weight: bold;
}

.ctrl-val {
  color: #FFFFFF;
  font-size: 24px;
  font-weight: bold;
}

.exit-btn {
  width: 200px;
  height: 68px;
  flex-shrink: 0;
  background-color: #3A1818;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
  margin-bottom: 10px;
}

.exit-btn-txt {
  color: #FF6B6B;
  font-weight: bold;
  text-align: center;
  lines: 1;
}
</style>
