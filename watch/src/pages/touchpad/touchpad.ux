<template>
  <div class="mouse-page">
    <div class="top-spacer"></div>

    <div class="top-row">
      <div class="back-btn" @click="sendAndroidBack">
        <text class="back-txt">{{strings.backBtn}}</text>
      </div>
      <div class="exit-btn" @click="exitApp">
        <text class="exit-txt">✕</text>
      </div>
    </div>

    <text class="status-line">{{debugText}}</text>

    <!-- Чистая зона тачпада без вложенных элементов -->
    <div
      class="touchpad-box"
      @touchstart="onTouchStart"
      @touchmove="onTouchMove"
      @touchend="onTouchEnd">
    </div>

    <div class="{{isScrollMode ? 'mode-btn mode-scroll' : 'mode-btn mode-cursor'}}" @click="toggleMode">
      <text class="{{isScrollMode ? 'mode-txt-scroll' : 'mode-txt-cursor'}}">{{isScrollMode ? strings.modeScroll : strings.modeCursor}}</text>
    </div>

    <div class="bottom-spacer"></div>
  </div>
</template>

<script>
import brightness from '@system.brightness'
import vibrator from '@system.vibrator'
import { getStrings } from '../../services/Localization'

export default {
  private: {
    strings: getStrings(),
    isConnected: false,
    isScrollMode: false,
    allowExit: false,
    debugText: 'Тачпад',
    lastX: 0,
    lastY: 0,
    startTime: 0,
    totalMoved: 0,
    bucketX: 0,
    bucketY: 0,
    flushTimer: null,
    statusSub: null
  },

  onInit() {
    this.strings = getStrings();
    this.debugText = this.strings.ready;

    if (globalThis.wearableBridge) {
      this.statusSub = globalThis.wearableBridge.addStatusListener((status) => {
        if (status === 'connected') {
          this.isConnected = true;
          this.debugText = this.strings.connected;
          this.shortVibrate();
        }
      });
    }

    this.flushTimer = setInterval(() => {
      if (this.bucketX !== 0 || this.bucketY !== 0) {
        const dx = Math.round(this.bucketX);
        const dy = Math.round(this.bucketY);
        this.bucketX = 0;
        this.bucketY = 0;

        if ((dx !== 0 || dy !== 0) && globalThis.wearableBridge) {
          globalThis.wearableBridge.sendPacket({
            tag: 'mouse',
            act: this.isScrollMode ? 's' : 'm',
            dx: dx,
            dy: dy
          });
        }
      }
    }, 40);
  },

  onShow() {
    try {
      brightness.setKeepScreenOn({ keepScreenOn: true });
    } catch (e) {}
  },

  onHide() {
    try {
      brightness.setKeepScreenOn({ keepScreenOn: false });
    } catch (e) {}
  },

  onDestroy() {
    if (this.flushTimer) {
      clearInterval(this.flushTimer);
    }
    if (this.statusSub && globalThis.wearableBridge) {
      globalThis.wearableBridge.removeStatusListener(this.statusSub);
    }
    try {
      brightness.setKeepScreenOn({ keepScreenOn: false });
    } catch (e) {}
  },

  onBackPress() {
    if (this.allowExit) {
      return false;
    }
    return true;
  },

  extractPoint(e) {
    const list = (e && e.touches && e.touches.length > 0)
      ? e.touches
      : (e && e.changedTouches ? e.changedTouches : null);
    if (!list || list.length === 0) return null;
    const pt = list[0];
    const x = pt.pageX !== undefined ? pt.pageX : (pt.clientX !== undefined ? pt.clientX : pt.offsetX);
    const y = pt.pageY !== undefined ? pt.pageY : (pt.clientY !== undefined ? pt.clientY : pt.offsetY);
    if (x === undefined || y === undefined) return null;
    return { x, y };
  },

  onTouchStart(e) {
    const pt = this.extractPoint(e);
    if (!pt) return;
    this.lastX = pt.x;
    this.lastY = pt.y;
    this.startTime = Date.now();
    this.totalMoved = 0;
  },

  onTouchMove(e) {
    const pt = this.extractPoint(e);
    if (!pt) return;

    const dx = pt.x - this.lastX;
    const dy = pt.y - this.lastY;
    this.lastX = pt.x;
    this.lastY = pt.y;

    this.totalMoved += Math.abs(dx) + Math.abs(dy);
    this.bucketX += dx;
    this.bucketY += dy;

    this.debugText = 'X:' + Math.round(pt.x) + ' Y:' + Math.round(pt.y);
  },

  onTouchEnd() {
    const elapsed = Date.now() - this.startTime;
    if (elapsed < 240 && this.totalMoved < 14) {
      this.shortVibrate();
      this.debugText = 'КЛИК (Tap)';
      if (globalThis.wearableBridge) {
        globalThis.wearableBridge.sendPacket({
          tag: 'mouse',
          act: 'tap'
        });
      }
    }
  },

  toggleMode() {
    this.isScrollMode = !this.isScrollMode;
    this.debugText = this.isScrollMode ? this.strings.hintScroll : this.strings.hintCursor;
    this.shortVibrate();
  },

  sendAndroidBack() {
    this.shortVibrate();
    this.debugText = '◄ Назад';
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({
        tag: 'mouse',
        act: 'back'
      });
    }
  },

  exitApp() {
    this.allowExit = true;
    this.$app.exit();
  },

  shortVibrate() {
    try {
      vibrator.vibrate({ mode: 'short' });
    } catch (e) {}
  }
}
</script>

<style>
.mouse-page {
  width: 212px;
  height: 520px;
  background-color: #000000;
  flex-direction: column;
  align-items: center;
}

.top-spacer {
  width: 200px;
  height: 22px;
  flex-shrink: 0;
}

.top-row {
  width: 196px;
  height: 48px;
  flex-shrink: 0;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 4px;
}

.back-btn {
  width: 132px;
  height: 48px;
  background-color: #262626;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
}

.back-txt {
  color: #FFFFFF;
  font-size: 19px;
  font-weight: bold;
}

.exit-btn {
  width: 54px;
  height: 48px;
  background-color: #381A1A;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
}

.exit-txt {
  color: #FF6B6B;
  font-size: 20px;
  font-weight: bold;
}

.status-line {
  width: 196px;
  height: 28px;
  flex-shrink: 0;
  color: #AAAAAA;
  font-size: 18px;
  font-weight: bold;
  text-align: center;
  lines: 1;
  margin-bottom: 4px;
}

.touchpad-box {
  width: 196px;
  height: 316px;
  flex-shrink: 0;
  background-color: #161616;
  border-width: 2px;
  border-color: #333333;
  border-radius: 32px;
  margin-bottom: 8px;
}

.mode-btn {
  width: 196px;
  height: 58px;
  flex-shrink: 0;
  border-radius: 26px;
  justify-content: center;
  align-items: center;
}

.mode-cursor {
  background-color: #FFFFFF;
}

.mode-scroll {
  background-color: #262626;
}

.mode-txt-cursor {
  color: #000000;
  font-size: 19px;
  font-weight: bold;
}

.mode-txt-scroll {
  color: #FFFFFF;
  font-size: 19px;
  font-weight: bold;
}

.bottom-spacer {
  width: 200px;
  height: 32px;
  flex-shrink: 0;
}
</style>
