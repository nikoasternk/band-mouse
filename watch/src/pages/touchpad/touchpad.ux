<template>
  <div class="pad-screen">
    <!-- Весь экран 212x520 работает как единый тачпад -->
    <div
      class="full-touchpad"
      @touchstart="onTouchStart"
      @touchmove="onTouchMove"
      @touchend="onTouchEnd"
      @touchcancel="onTouchCancel">
    </div>

    <!-- Кнопка выхода в меню (динамический размер из настроек) -->
    <div
      class="top-menu-btn"
      style="top: 12px; left: {{menuLeft}}px; width: {{menuW}}px; height: {{menuH}}px; border-radius: {{menuRadius}}px;"
      @click="openMenu">
      <text class="top-menu-txt" style="font-size: {{menuFont}}px;">{{strings.menuTopBtn}}</text>
    </div>

    <!-- 3 кнопки панели телефона (динамический размер и мягкая вибрация) -->
    <div
      class="phone-nav-bar"
      if="{{showNavBar}}"
      style="top: {{navTop}}px; left: {{navLeft}}px; width: {{navRowW}}px; height: {{navBtnH}}px;">
      <div
        class="nav-btn"
        style="width: {{navBtnW}}px; height: {{navBtnH}}px; border-radius: {{navBtnRadius}}px;"
        @click="onTriangleTap">
        <text class="nav-txt" style="font-size: {{navFont}}px;">◀</text>
      </div>

      <div
        class="nav-btn"
        style="width: {{navBtnW}}px; height: {{navBtnH}}px; border-radius: {{navBtnRadius}}px;"
        @click="onCircleTap">
        <text class="nav-txt" style="font-size: {{navFont}}px;">●</text>
      </div>

      <div
        class="nav-btn"
        style="width: {{navBtnW}}px; height: {{navBtnH}}px; border-radius: {{navBtnRadius}}px;"
        @touchstart="onSquareTouchStart"
        @touchend="onSquareTouchEnd"
        @touchcancel="onSquareTouchCancel">
        <text class="nav-txt" style="font-size: {{navFont}}px;">■</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { getStrings } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    controlMode: 'cursor',
    activeGestureMode: 'cursor',
    tapLockPx: 4,
    hybridHoldMs: 400,
    showNavBar: true,
    stealthOnSquare: true,
    stealthHoldSec: 3,

    menuW: 88,
    menuH: 32,
    menuLeft: 62,
    menuRadius: 16,
    menuFont: 16,

    navTop: 50,
    navLeft: 24,
    navRowW: 164,
    navBtnW: 50,
    navBtnH: 38,
    navBtnRadius: 14,
    navFont: 17,

    lastX: 0,
    lastY: 0,
    startTime: 0,
    totalMoved: 0,
    isMoveUnlocked: false,
    bucketX: 0,
    bucketY: 0,
    flushTimer: null,
    hybridHoldTimer: null,
    squareHoldTimer: null,
    squareLongTriggered: false
  },

  onInit() {
    this.flushTimer = setInterval(() => {
      if (this.bucketX !== 0 || this.bucketY !== 0) {
        const dx = Math.round(this.bucketX);
        const dy = Math.round(this.bucketY);

        if (dx !== 0 || dy !== 0) {
          this.bucketX -= dx;
          this.bucketY -= dy;

          if (globalThis.wearableBridge) {
            const actType = this.activeGestureMode === 'scroll' ? 's' : 'm';
            globalThis.wearableBridge.sendPacket({
              tag: 'mouse',
              act: actType,
              dx: dx,
              dy: dy
            });
          }
        }
      }
    }, 30);
  },

  onShow() {
    globalThis.notifyPageShown();
    globalThis.loadMouseConfig((cfg) => {
      this.strings = getStrings(cfg.language || 'auto');
      this.controlMode = cfg.controlMode || 'cursor';
      this.tapLockPx = cfg.tapLockPx !== undefined ? cfg.tapLockPx : 4;
      this.hybridHoldMs = cfg.hybridHoldMs || 400;
      this.showNavBar = cfg.showNavBar !== false;
      this.stealthOnSquare = cfg.stealthOnSquare !== false;
      this.stealthHoldSec = cfg.stealthHoldSec || 3;
      this.computeLayoutMetrics(cfg.menuBtnScale || 100, cfg.navBarScale || 100);
    });
  },

  onHide() {
    this.clearSquareTimer();
    this.clearHybridTimer();
    globalThis.notifyPageHidden();
  },

  onDestroy() {
    this.clearSquareTimer();
    this.clearHybridTimer();
    if (this.flushTimer) {
      clearInterval(this.flushTimer);
    }
  },

  onBackPress() {
    return true;
  },

  computeLayoutMetrics(menuScalePct, navScalePct) {
    const mScale = Math.max(0.7, Math.min(1.4, menuScalePct / 100));
    this.menuW = Math.round(88 * mScale);
    this.menuH = Math.round(32 * mScale);
    this.menuLeft = Math.round((212 - this.menuW) / 2);
    this.menuRadius = Math.round(this.menuH / 2);
    this.menuFont = Math.max(11, Math.round(16 * mScale));

    const nScale = Math.max(0.7, Math.min(1.3, navScalePct / 100));
    this.navBtnW = Math.round(50 * nScale);
    this.navBtnH = Math.round(38 * nScale);
    this.navRowW = Math.min(204, Math.round(164 * nScale));
    this.navLeft = Math.round((212 - this.navRowW) / 2);
    this.navTop = 12 + this.menuH + 6;
    this.navBtnRadius = Math.round(14 * nScale);
    this.navFont = Math.max(12, Math.round(17 * nScale));
  },

  extractPoint(e) {
    const list = (e && e.touches && e.touches.length > 0)
      ? e.touches
      : (e && e.changedTouches ? e.changedTouches : null);
    if (!list || list.length === 0) return null;
    const pt = list[0];
    const x = pt.pageX !== undefined ? pt.pageX : (pt.clientX !== undefined ? pt.clientX : pt.offsetX);
    const y = pt.pageY !== undefined ? pt.pageY : (pt.clientY !== undefined ? pt.clientY : pt.offsetY);
    if (x === undefined || y === undefined) return null;
    return { x, y };
  },

  onTouchStart(e) {
    const pt = this.extractPoint(e);
    if (!pt) return;
    this.lastX = pt.x;
    this.lastY = pt.y;
    this.startTime = Date.now();
    this.totalMoved = 0;
    this.bucketX = 0;
    this.bucketY = 0;
    this.isMoveUnlocked = this.tapLockPx <= 0;
    this.clearHybridTimer();

    if (this.controlMode === 'scroll') {
      this.activeGestureMode = 'scroll';
    } else if (this.controlMode === 'hybrid') {
      this.activeGestureMode = 'cursor';
      this.hybridHoldTimer = setTimeout(() => {
        this.hybridHoldTimer = null;
        if (!this.isMoveUnlocked || this.totalMoved < Math.max(6, this.tapLockPx + 2)) {
          this.activeGestureMode = 'scroll';
          this.isMoveUnlocked = true;
          globalThis.triggerHaptic('soft');
        }
      }, this.hybridHoldMs);
    } else {
      this.activeGestureMode = 'cursor';
    }
  },

  onTouchMove(e) {
    const pt = this.extractPoint(e);
    if (!pt) return;

    const dx = pt.x - this.lastX;
    const dy = pt.y - this.lastY;
    this.lastX = pt.x;
    this.lastY = pt.y;

    this.totalMoved += Math.abs(dx) + Math.abs(dy);

    if (!this.isMoveUnlocked) {
      if (this.totalMoved < this.tapLockPx) {
        return;
      }
      this.isMoveUnlocked = true;
      // Если в режиме Гибрид пользователь сразу начал двигать палец до таймера — остаёмся в режиме курсора
      if (this.hybridHoldTimer) {
        this.clearHybridTimer();
      }
    }

    this.bucketX += dx;
    this.bucketY += dy;
  },

  onTouchEnd() {
    this.clearHybridTimer();
    const elapsed = Date.now() - this.startTime;

    // В режиме скролла (или после срабатывания гибридного скролла) клик полностью отключён!
    if (this.activeGestureMode === 'scroll' || this.controlMode === 'scroll') {
      this.bucketX = 0;
      this.bucketY = 0;
      return;
    }

    if (elapsed < 240 && this.totalMoved <= Math.max(3, this.tapLockPx)) {
      this.bucketX = 0;
      this.bucketY = 0;
      globalThis.triggerHaptic('short');
      if (globalThis.wearableBridge) {
        globalThis.wearableBridge.sendPacket({
          tag: 'mouse',
          act: 'tap'
        });
      }
    }
  },

  onTouchCancel() {
    this.clearHybridTimer();
    this.bucketX = 0;
    this.bucketY = 0;
  },

  clearHybridTimer() {
    if (this.hybridHoldTimer) {
      clearTimeout(this.hybridHoldTimer);
      this.hybridHoldTimer = null;
    }
  },

  openMenu() {
    globalThis.triggerHaptic('soft');
    router.push({ uri: 'pages/menu' });
  },

  onTriangleTap() {
    globalThis.triggerHaptic('soft');
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'back' });
    }
  },

  onCircleTap() {
    globalThis.triggerHaptic('soft');
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'home' });
    }
  },

  onSquareTouchStart() {
    this.clearSquareTimer();
    this.squareLongTriggered = false;
    globalThis.triggerHaptic('soft');
    if (this.stealthOnSquare) {
      const holdMs = Math.max(1, Math.min(5, this.stealthHoldSec || 3)) * 1000;
      this.squareHoldTimer = setTimeout(() => {
        this.squareHoldTimer = null;
        this.squareLongTriggered = true;
        globalThis.triggerHaptic('long');
        if (globalThis.wearableBridge) {
          globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'stealth' });
        }
      }, holdMs);
    }
  },

  onSquareTouchEnd() {
    const wasHeld = this.squareLongTriggered;
    this.clearSquareTimer();
    if (!wasHeld) {
      if (globalThis.wearableBridge) {
        globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'recents' });
      }
    }
  },

  onSquareTouchCancel() {
    this.clearSquareTimer();
  },

  clearSquareTimer() {
    if (this.squareHoldTimer) {
      clearTimeout(this.squareHoldTimer);
      this.squareHoldTimer = null;
    }
  }
}
</script>

<style>
.pad-screen {
  position: relative;
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.full-touchpad {
  width: 212px;
  height: 520px;
  background-color: #101010;
  border-width: 2px;
  border-color: #262626;
  border-radius: 96px;
}

.top-menu-btn {
  position: absolute;
  background-color: #242424;
  justify-content: center;
  align-items: center;
}

.top-menu-txt {
  color: #DDDDDD;
  font-weight: bold;
  lines: 1;
}

.phone-nav-bar {
  position: absolute;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.nav-btn {
  background-color: #202020;
  justify-content: center;
  align-items: center;
}

.nav-txt {
  color: #FFFFFF;
  font-weight: bold;
  lines: 1;
}
</style>
