<template>
  <div class="pad-screen">
    <div
      class="full-touchpad"
      @touchstart="onTouchStart"
      @touchmove="onTouchMove"
      @touchend="onTouchEnd"
      @touchcancel="onTouchCancel">
    </div>

    <div
      class="menu-hit-zone"
      style="top: 0px; left: 0px; width: 212px; height: {{menuHitH}}px;"
      @click="openMenu">
      <div
        class="top-menu-visual"
        style="width: {{menuVisW}}px; height: {{menuVisH}}px; border-radius: {{menuVisRadius}}px; margin-top: 10px;">
        <text class="top-menu-txt" style="font-size: {{menuFont}}px;">{{strings.menuTopBtn}}</text>
      </div>
    </div>

    <div
      class="phone-nav-hit-bar"
      if="{{showNavBar}}"
      style="top: {{navHitTop}}px; left: 0px; width: 212px; height: {{navHitH}}px;">
      <div
        class="nav-hit-cell"
        style="width: {{navHitCellW}}px; height: {{navHitH}}px;"
        @click="onTriangleTap">
        <div
          class="nav-btn-visual"
          style="width: {{navVisW}}px; height: {{navVisH}}px; border-radius: {{navVisRadius}}px;">
          <text class="nav-txt" style="font-size: {{navFont}}px;">◀</text>
        </div>
      </div>

      <div
        class="nav-hit-cell"
        style="width: {{navHitCellW}}px; height: {{navHitH}}px;"
        @click="onCircleTap">
        <div
          class="nav-btn-visual"
          style="width: {{navVisW}}px; height: {{navVisH}}px; border-radius: {{navVisRadius}}px;">
          <text class="nav-txt" style="font-size: {{navFont}}px;">●</text>
        </div>
      </div>

      <div
        class="nav-hit-cell"
        style="width: {{navHitCellW}}px; height: {{navHitH}}px;"
        @touchstart="onSquareTouchStart"
        @touchend="onSquareTouchEnd"
        @touchcancel="onSquareTouchCancel">
        <div
          class="nav-btn-visual"
          style="width: {{navVisW}}px; height: {{navVisH}}px; border-radius: {{navVisRadius}}px;">
          <text class="nav-txt" style="font-size: {{navFont}}px;">■</text>
        </div>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import { getStrings } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    controlMode: 'cursor',
    dragScroll: true,
    activeGestureMode: 'cursor',
    hybridPending: false,
    scrollStreaming: false,
    idleHoldTicks: 0,
    tapLockPx: 4,
    hybridHoldMs: 400,
    showNavBar: true,
    stealthOnSquare: true,
    stealthHoldSec: 3,

    menuHitH: 46,
    menuVisW: 88,
    menuVisH: 32,
    menuVisRadius: 16,
    menuFont: 16,

    navHitTop: 46,
    navHitH: 46,
    navHitCellW: 64,
    navVisW: 50,
    navVisH: 38,
    navVisRadius: 14,
    navFont: 17,

    startX: 0,
    startY: 0,
    lastX: 0,
    lastY: 0,
    startTime: 0,
    totalMoved: 0,
    isMoveUnlocked: false,
    bucketX: 0,
    bucketY: 0,
    flushTimer: null,
    hybridHoldTimer: null,
    squareHoldTimer: null,
    squareLongTriggered: false
  },

  onInit() {
    this.flushTimer = setInterval(() => {
      const dx = Math.round(this.bucketX);
      const dy = Math.round(this.bucketY);

      if (dx !== 0 || dy !== 0) {
        this.bucketX -= dx;
        this.bucketY -= dy;
        this.idleHoldTicks = 0;

        if (globalThis.wearableBridge) {
          if (this.activeGestureMode === 'scroll') {
            this.scrollStreaming = true;
            globalThis.wearableBridge.sendPacket({
              tag: 'mouse',
              act: 's_move',
              dx: dx,
              dy: dy,
              drag: this.dragScroll
            });
          } else {
            globalThis.wearableBridge.sendPacket({
              tag: 'mouse',
              act: 'm',
              dx: dx,
              dy: dy
            });
          }
        }
      } else if (this.scrollStreaming && this.activeGestureMode === 'scroll') {
        this.idleHoldTicks += 1;
        if (this.idleHoldTicks >= 9) {
          this.idleHoldTicks = 0;
          if (globalThis.wearableBridge) {
            globalThis.wearableBridge.sendPacket({
              tag: 'mouse',
              act: 's_hold',
              drag: this.dragScroll
            });
          }
        }
      }
    }, 28);
  },

  onShow() {
    globalThis.notifyPageShown();
    globalThis.loadMouseConfig((cfg) => {
      this.strings = getStrings(cfg.language || 'auto');
      this.controlMode = cfg.controlMode || 'cursor';
      this.dragScroll = cfg.dragScroll !== false;
      this.tapLockPx = cfg.tapLockPx !== undefined ? cfg.tapLockPx : 4;
      this.hybridHoldMs = cfg.hybridHoldMs || 400;
      this.showNavBar = cfg.showNavBar !== false;
      this.stealthOnSquare = cfg.stealthOnSquare !== false;
      this.stealthHoldSec = cfg.stealthHoldSec || 3;
      this.computeLayoutMetrics(cfg.menuBtnScale || 100, cfg.navBarScale || 100);
    });
  },

  onHide() {
    this.finishScrollStreamIfNeeded();
    this.clearSquareTimer();
    this.clearHybridTimer();
    globalThis.notifyPageHidden();
  },

  onDestroy() {
    this.finishScrollStreamIfNeeded();
    this.clearSquareTimer();
    this.clearHybridTimer();
    if (this.flushTimer) {
      clearInterval(this.flushTimer);
    }
  },

  onBackPress() {
    return true;
  },

  computeLayoutMetrics(menuScalePct, navScalePct) {
    const mScale = Math.max(0.7, Math.min(1.4, menuScalePct / 100));
    this.menuVisW = Math.round(88 * mScale);
    this.menuVisH = Math.round(32 * mScale);
    this.menuVisRadius = Math.round(this.menuVisH / 2);
    this.menuFont = Math.max(11, Math.round(16 * mScale));
    this.menuHitH = this.menuVisH + 14;

    const nScale = Math.max(0.7, Math.min(1.3, navScalePct / 100));
    this.navVisW = Math.round(50 * nScale);
    this.navVisH = Math.round(38 * nScale);
    this.navVisRadius = Math.round(14 * nScale);
    this.navFont = Math.max(12, Math.round(17 * nScale));
    this.navHitTop = this.menuHitH;
    this.navHitH = this.navVisH + 8;
    this.navHitCellW = Math.min(70, Math.max(this.navVisW + 8, Math.round(58 * nScale)));
  },

  extractPoint(e) {
    const list = (e && e.touches && e.touches.length > 0)
      ? e.touches
      : (e && e.changedTouches ? e.changedTouches : null);
    if (!list || list.length === 0) return null;
    const pt = list[0];
    const x = pt.pageX !== undefined ? pt.pageX : (pt.clientX !== undefined ? pt.clientX : pt.offsetX);
    const y = pt.pageY !== undefined ? pt.pageY : (pt.clientY !== undefined ? pt.clientY : pt.offsetY);
    if (x === undefined || y === undefined) return null;
    return { x, y };
  },

  startScrollStream() {
    this.scrollStreaming = true;
    this.idleHoldTicks = 0;
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({
        tag: 'mouse',
        act: 's_start',
        drag: this.dragScroll
      });
    }
  },

  finishScrollStreamIfNeeded() {
    if (this.scrollStreaming) {
      this.scrollStreaming = false;
      this.idleHoldTicks = 0;
      if (globalThis.wearableBridge) {
        globalThis.wearableBridge.sendPacket({
          tag: 'mouse',
          act: 's_end'
        });
      }
    }
  },

  onTouchStart(e) {
    const pt = this.extractPoint(e);
    if (!pt) return;
    this.startX = pt.x;
    this.startY = pt.y;
    this.lastX = pt.x;
    this.lastY = pt.y;
    this.startTime = Date.now();
    this.totalMoved = 0;
    this.bucketX = 0;
    this.bucketY = 0;
    this.scrollStreaming = false;
    this.idleHoldTicks = 0;
    this.clearHybridTimer();

    if (this.controlMode === 'scroll') {
      this.activeGestureMode = 'scroll';
      this.hybridPending = false;
      this.isMoveUnlocked = true;
      this.startScrollStream();
    } else if (this.controlMode === 'hybrid') {
      this.activeGestureMode = 'cursor';
      this.hybridPending = true;
      this.isMoveUnlocked = false;
      this.hybridHoldTimer = setTimeout(() => {
        this.hybridHoldTimer = null;
        if (this.hybridPending) {
          this.hybridPending = false;
          this.activeGestureMode = 'scroll';
          this.isMoveUnlocked = true;
          this.bucketX = 0;
          this.bucketY = 0;
          globalThis.triggerHaptic('soft');
          this.startScrollStream();
        }
      }, this.hybridHoldMs);
    } else {
      this.activeGestureMode = 'cursor';
      this.hybridPending = false;
      this.isMoveUnlocked = this.tapLockPx <= 0;
    }
  },

  onTouchMove(e) {
    const pt = this.extractPoint(e);
    if (!pt) return;

    const dx = pt.x - this.lastX;
    const dy = pt.y - this.lastY;
    this.lastX = pt.x;
    this.lastY = pt.y;

    this.totalMoved += Math.abs(dx) + Math.abs(dy);
    const distFromStart = Math.hypot(pt.x - this.startX, pt.y - this.startY);

    if (this.hybridPending) {
      if (distFromStart < Math.max(10, this.tapLockPx + 5)) {
        return;
      }
      this.hybridPending = false;
      this.clearHybridTimer();
      this.activeGestureMode = 'cursor';
      this.isMoveUnlocked = true;
    } else if (!this.isMoveUnlocked) {
      if (distFromStart < this.tapLockPx) {
        return;
      }
      this.isMoveUnlocked = true;
    }

    this.bucketX += dx;
    this.bucketY += dy;
  },

  onTouchEnd() {
    this.hybridPending = false;
    this.clearHybridTimer();
    const elapsed = Date.now() - this.startTime;

    if (this.activeGestureMode === 'scroll' || this.controlMode === 'scroll') {
      const remX = Math.round(this.bucketX);
      const remY = Math.round(this.bucketY);
      this.bucketX = 0;
      this.bucketY = 0;
      if ((remX !== 0 || remY !== 0) && globalThis.wearableBridge) {
        this.scrollStreaming = true;
        globalThis.wearableBridge.sendPacket({
          tag: 'mouse',
          act: 's_move',
          dx: remX,
          dy: remY,
          drag: this.dragScroll
        });
      }
      this.finishScrollStreamIfNeeded();
      return;
    }

    if (elapsed < 240 && !this.isMoveUnlocked) {
      this.bucketX = 0;
      this.bucketY = 0;
      globalThis.triggerHaptic('soft');
      if (globalThis.wearableBridge) {
        globalThis.wearableBridge.sendPacket({
          tag: 'mouse',
          act: 'tap'
        });
      }
    }
  },

  onTouchCancel() {
    this.hybridPending = false;
    this.clearHybridTimer();
    this.bucketX = 0;
    this.bucketY = 0;
    this.finishScrollStreamIfNeeded();
  },

  clearHybridTimer() {
    if (this.hybridHoldTimer) {
      clearTimeout(this.hybridHoldTimer);
      this.hybridHoldTimer = null;
    }
  },

  openMenu() {
    globalThis.triggerHaptic('soft');
    router.push({ uri: 'pages/menu' });
  },

  onTriangleTap() {
    globalThis.triggerHaptic('soft');
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'back' });
    }
  },

  onCircleTap() {
    globalThis.triggerHaptic('soft');
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'home' });
    }
  },

  onSquareTouchStart() {
    this.clearSquareTimer();
    this.squareLongTriggered = false;
    globalThis.triggerHaptic('soft');
    if (this.stealthOnSquare) {
      const holdMs = Math.max(1, Math.min(5, this.stealthHoldSec || 3)) * 1000;
      this.squareHoldTimer = setTimeout(() => {
        this.squareHoldTimer = null;
        this.squareLongTriggered = true;
        globalThis.triggerHaptic('soft');
        if (globalThis.wearableBridge) {
          globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'stealth' });
        }
      }, holdMs);
    }
  },

  onSquareTouchEnd() {
    const wasHeld = this.squareLongTriggered;
    this.clearSquareTimer();
    if (!wasHeld) {
      if (globalThis.wearableBridge) {
        globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'recents' });
      }
    }
  },

  onSquareTouchCancel() {
    this.clearSquareTimer();
  },

  clearSquareTimer() {
    if (this.squareHoldTimer) {
      clearTimeout(this.squareHoldTimer);
      this.squareHoldTimer = null;
    }
  }
}
</script>

<style>
.pad-screen {
  position: relative;
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.full-touchpad {
  width: 212px;
  height: 520px;
  background-color: #101010;
  border-width: 2px;
  border-color: #262626;
  border-radius: 96px;
}

.menu-hit-zone {
  position: absolute;
  justify-content: center;
  align-items: center;
}

.top-menu-visual {
  background-color: #242424;
  justify-content: center;
  align-items: center;
}

.top-menu-txt {
  color: #DDDDDD;
  font-weight: bold;
  lines: 1;
}

.phone-nav-hit-bar {
  position: absolute;
  flex-direction: row;
  justify-content: center;
  align-items: center;
}

.nav-hit-cell {
  justify-content: center;
  align-items: center;
}

.nav-btn-visual {
  background-color: #202020;
  justify-content: center;
  align-items: center;
}

.nav-txt {
  color: #FFFFFF;
  font-weight: bold;
  lines: 1;
}
</style>
