<template>
  <div class="pad-screen">
    <!-- Весь экран 212x520 работает как единый тачпад -->
    <div
      class="full-touchpad"
      @touchstart="onTouchStart"
      @touchmove="onTouchMove"
      @touchend="onTouchEnd">
    </div>

    <!-- Маленькая кнопка выхода в меню в самом верху посередине -->
    <div class="top-menu-btn" @click="openMenu">
      <text class="top-menu-txt">{{strings.menuTopBtn}}</text>
    </div>

    <!-- 3 небольшие кнопки панели телефона (треугольник, круг, квадрат) чуть ниже кнопки меню -->
    <div class="phone-nav-bar" if="{{showNavBar}}">
      <div class="nav-btn" @click="onTriangleTap">
        <text class="nav-txt">◀</text>
      </div>

      <div class="nav-btn" @click="onCircleTap">
        <text class="nav-txt">●</text>
      </div>

      <div
        class="nav-btn"
        @touchstart="onSquareTouchStart"
        @touchend="onSquareTouchEnd"
        @touchcancel="onSquareTouchCancel">
        <text class="nav-txt">■</text>
      </div>
    </div>
  </div>
</template>

<script>
import router from '@system.router'
import vibrator from '@system.vibrator'
import { getStrings } from '../../services/Localization'

export default {
  private: {
    strings: getStrings('auto'),
    isScrollMode: false,
    showNavBar: true,
    stealthOnSquare: true,
    lastX: 0,
    lastY: 0,
    startTime: 0,
    totalMoved: 0,
    bucketX: 0,
    bucketY: 0,
    flushTimer: null,
    squareHoldTimer: null,
    squareLongTriggered: false
  },

  onInit() {
    this.flushTimer = setInterval(() => {
      if (this.bucketX !== 0 || this.bucketY !== 0) {
        const dx = Math.round(this.bucketX);
        const dy = Math.round(this.bucketY);
        this.bucketX = 0;
        this.bucketY = 0;

        if ((dx !== 0 || dy !== 0) && globalThis.wearableBridge) {
          globalThis.wearableBridge.sendPacket({
            tag: 'mouse',
            act: this.isScrollMode ? 's' : 'm',
            dx: dx,
            dy: dy
          });
        }
      }
    }, 38);
  },

  onShow() {
    globalThis.notifyPageShown();
    globalThis.loadMouseConfig((cfg) => {
      this.strings = getStrings(cfg.language || 'auto');
      this.isScrollMode = cfg.controlMode === 'scroll';
      this.showNavBar = cfg.showNavBar !== false;
      this.stealthOnSquare = cfg.stealthOnSquare !== false;
    });
  },

  onHide() {
    this.clearSquareTimer();
    globalThis.notifyPageHidden();
  },

  onDestroy() {
    this.clearSquareTimer();
    if (this.flushTimer) {
      clearInterval(this.flushTimer);
    }
  },

  onBackPress() {
    return true;
  },

  extractPoint(e) {
    const list = (e && e.touches && e.touches.length > 0)
      ? e.touches
      : (e && e.changedTouches ? e.changedTouches : null);
    if (!list || list.length === 0) return null;
    const pt = list[0];
    const x = pt.pageX !== undefined ? pt.pageX : (pt.clientX !== undefined ? pt.clientX : pt.offsetX);
    const y = pt.pageY !== undefined ? pt.pageY : (pt.clientY !== undefined ? pt.clientY : pt.offsetY);
    if (x === undefined || y === undefined) return null;
    return { x, y };
  },

  onTouchStart(e) {
    const pt = this.extractPoint(e);
    if (!pt) return;
    this.lastX = pt.x;
    this.lastY = pt.y;
    this.startTime = Date.now();
    this.totalMoved = 0;
  },

  onTouchMove(e) {
    const pt = this.extractPoint(e);
    if (!pt) return;

    const dx = pt.x - this.lastX;
    const dy = pt.y - this.lastY;
    this.lastX = pt.x;
    this.lastY = pt.y;

    this.totalMoved += Math.abs(dx) + Math.abs(dy);
    this.bucketX += dx;
    this.bucketY += dy;
  },

  onTouchEnd() {
    const elapsed = Date.now() - this.startTime;
    if (elapsed < 230 && this.totalMoved < 14) {
      this.shortVibrate();
      if (globalThis.wearableBridge) {
        globalThis.wearableBridge.sendPacket({
          tag: 'mouse',
          act: 'tap'
        });
      }
    }
  },

  openMenu() {
    this.shortVibrate();
    router.push({ uri: 'pages/menu' });
  },

  onTriangleTap() {
    this.shortVibrate();
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'back' });
    }
  },

  onCircleTap() {
    this.shortVibrate();
    if (globalThis.wearableBridge) {
      globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'home' });
    }
  },

  onSquareTouchStart() {
    this.clearSquareTimer();
    this.squareLongTriggered = false;
    if (this.stealthOnSquare) {
      this.squareHoldTimer = setTimeout(() => {
        this.squareHoldTimer = null;
        this.squareLongTriggered = true;
        this.longVibrate();
        if (globalThis.wearableBridge) {
          globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'stealth' });
        }
      }, 3000);
    }
  },

  onSquareTouchEnd() {
    const wasHeld = this.squareLongTriggered;
    this.clearSquareTimer();
    if (!wasHeld) {
      this.shortVibrate();
      if (globalThis.wearableBridge) {
        globalThis.wearableBridge.sendPacket({ tag: 'mouse', act: 'recents' });
      }
    }
  },

  onSquareTouchCancel() {
    this.clearSquareTimer();
  },

  clearSquareTimer() {
    if (this.squareHoldTimer) {
      clearTimeout(this.squareHoldTimer);
      this.squareHoldTimer = null;
    }
  },

  shortVibrate() {
    try { vibrator.vibrate({ mode: 'short' }); } catch (e) {}
  },

  longVibrate() {
    try { vibrator.vibrate({ mode: 'long' }); } catch (e) { this.shortVibrate(); }
  }
}
</script>

<style>
.pad-screen {
  position: relative;
  width: 212px;
  height: 520px;
  background-color: #000000;
}

.full-touchpad {
  width: 212px;
  height: 520px;
  background-color: #101010;
  border-width: 2px;
  border-color: #262626;
  border-radius: 96px;
}

.top-menu-btn {
  position: absolute;
  top: 12px;
  left: 62px;
  width: 88px;
  height: 32px;
  background-color: #242424;
  border-radius: 16px;
  justify-content: center;
  align-items: center;
}

.top-menu-txt {
  color: #DDDDDD;
  font-size: 16px;
  font-weight: bold;
}

.phone-nav-bar {
  position: absolute;
  top: 50px;
  left: 24px;
  width: 164px;
  height: 38px;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.nav-btn {
  width: 50px;
  height: 38px;
  background-color: #202020;
  border-radius: 14px;
  justify-content: center;
  align-items: center;
}

.nav-txt {
  color: #FFFFFF;
  font-size: 17px;
  font-weight: bold;
}
</style>
